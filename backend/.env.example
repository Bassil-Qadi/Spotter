DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=your-api.onrender.com
# comma-separated; *.vercel.app is already allowed
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# Nominatim requires an identifying User-Agent (ideally with a contact)
NOMINATIM_USER_AGENT=spotter-eld-trip-planner/1.0 (you@example.com)
